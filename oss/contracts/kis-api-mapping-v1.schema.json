    "catalog_commit": {
      "const": "2077773a69a428daf63e148182511f068cc45de3"
    },
    "catalog_scope": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object"
    },
    "auth_hosts": {
      "type": "object"
    },
    "authentication": {
      "type": "object"
    },
    "operations": {
      "type": "array"
    },
    "not_exposed": {
      "type": "object"
    },
