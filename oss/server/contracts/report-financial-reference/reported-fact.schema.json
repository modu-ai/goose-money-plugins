          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "selector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "semantic_binding_verified": {
          "const": true
        },
        "data_kind": {
          "enum": [
            "synthetic",
            "actual"
          ]
