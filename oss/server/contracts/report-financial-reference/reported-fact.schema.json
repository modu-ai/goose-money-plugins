{
  "type": "object",
  "properties": {
    "fact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "concept": {
      "enum": [
        "reported.revenue",
        "reported.operating_profit",
        "reported.net_income_total",
        "reported.net_income_common",
        "reported.cfo",
        "reported.capex",
        "reported.debt",
        "reported.cash",
        "reported.equity",
        "reported.liabilities",
        "reported.equity_common_open",
        "reported.equity_common_close",
        "reported.shares_weighted"
      ]
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "security_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "share_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "venue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "population": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "date_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state": {
      "const": "available"
    },
    "value": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
    },
    "unit": {
      "enum": [
        "money",
        "shares"
      ]
    },
    "scale": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "data_kind": {
      "enum": [
        "synthetic",
        "actual"
      ]
    },
    "basis": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "consolidated",
            "standalone"
          ]
        },
        "standard": {
          "enum": [
            "IFRS",
            "K-IFRS",
            "US-GAAP",
            "K-GAAP"
