{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "moai.financial.component-derivation-input.v1"
    },
    "request": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "enum": [
            "us-gaap.ppe-plus-intangibles.v1",
            "ifrs-full.ppe-plus-intangibles.v1",
            "us-gaap.short-plus-long-debt.v1",
            "us-gaap.short-plus-current-plus-noncurrent-debt.v1",
            "ifrs-full.current-plus-noncurrent-borrowings.v1"
          ]
        },
        "destination_role": {
          "type": "string",
          "enum": [
            "reported.capex",
            "reported.debt"
          ]
        },
        "cutoff": {
          "type": "string",
          "maxLength": 80,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "policy_id",
        "destination_role",
        "cutoff"
      ],
      "additionalProperties": false
    },
    "leaves": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,63}$"
          },
          "candidate": {}
        },
        "required": [
          "component_id",
          "candidate"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "request",
    "leaves"
  ],
  "additionalProperties": false
}
