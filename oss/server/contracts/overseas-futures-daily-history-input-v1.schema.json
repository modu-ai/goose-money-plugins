{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "maxLength": 13,
      "pattern": "^[A-Z0-9]{1,10}[FGHJKMNQUVXZ]\\d{2}$"
    },
    "exchange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[A-Z0-9]+$"
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{8}$"
    },
    "count": {
      "type": "string",
      "pattern": "^(?:[1-9]|[1-3][0-9]|40)$"
    },
    "period": {
      "type": "string",
      "const": "D"
    }
  },
  "required": [
    "symbol",
    "exchange",
    "end_date",
    "count",
    "period"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.moai.invalid/stock/overseas-futures-daily-history-input-v1.schema.json",
  "$comment": "Offline JSON Schema projection. Runtime Zod schema additionally enforces actual calendar dates, exact receipt equality, row count/coverage/cursor provenance, identity and date-range guards. The .invalid namespace is an identifier, not a hosted resource."
}
