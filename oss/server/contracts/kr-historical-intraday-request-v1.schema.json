{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "const": "kis.kr_historical_intraday"
    },
    "method": {
      "type": "string",
      "const": "GET"
    },
    "path": {
      "type": "string",
      "const": "/uapi/domestic-stock/v1/quotations/inquire-time-dailychartprice"
    },
    "tr_id": {
      "type": "string",
      "const": "FHKST03010230"
    },
    "tr_cont": {
      "type": "string",
      "const": ""
    },
    "query": {
      "type": "object",
      "properties": {
        "FID_COND_MRKT_DIV_CODE": {
          "type": "string",
          "enum": [
            "J",
            "NX",
            "UN"
          ]
        },
        "FID_INPUT_ISCD": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "FID_INPUT_DATE_1": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "FID_INPUT_HOUR_1": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3])[0-5]\\d[0-5]\\d$"
        },
        "FID_PW_DATA_INCU_YN": {
          "type": "string",
          "enum": [
            "Y",
            "N"
          ]
        },
        "FID_FAKE_TICK_INCU_YN": {
          "type": "string",
          "const": ""
        }
      },
      "required": [
        "FID_COND_MRKT_DIV_CODE",
        "FID_INPUT_ISCD",
        "FID_INPUT_DATE_1",
        "FID_INPUT_HOUR_1",
        "FID_PW_DATA_INCU_YN",
        "FID_FAKE_TICK_INCU_YN"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "operation",
    "method",
    "path",
    "tr_id",
    "tr_cont",
    "query"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.moai.invalid/stock/kr-historical-intraday-request-v1.schema.json",
  "$comment": "Offline shape projection only. Runtime Zod additionally checks real calendar dates, exact receipt/availability equality, row counts/coverage, continuation provenance and duplicate/blank-label status. Entry point additionally snapshots and bounds hostile inputs and responses. The .invalid namespace is an identifier, not a hosted resource."
