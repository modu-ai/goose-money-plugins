{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "operation_ref": {
          "type": "string",
          "const": "KIS-280"
        },
        "query": {
          "type": "object",
          "properties": {
            "NCOD": {
              "type": "string",
              "enum": [
                "CN",
                "HK",
                "US",
                "JP",
                "VN"
              ]
            },
            "SYMB": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[A-Z0-9][A-Z0-9.-]*(?![\\s\\S])"
            },
            "ST_YMD": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8
            },
            "ED_YMD": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8
            }
          },
          "required": [
            "NCOD",
            "SYMB",
            "ST_YMD",
            "ED_YMD"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operation_ref",
        "query"
      ],
      "additionalProperties": false
    },
    "cutoff": {
      "type": "string",
      "maxLength": 80,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "request",
    "cutoff"
  ],
  "additionalProperties": false
}
