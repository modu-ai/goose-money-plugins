{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instrument_code": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "period_code": {
      "type": "string",
      "enum": [
        "W",
        "M",
        "Y"
      ]
    },
    "market_code": {
      "type": "string",
      "const": "U"
    }
  },
  "required": [
    "instrument_code",
    "start_date",
    "end_date",
    "period_code",
    "market_code"
  ],
  "additionalProperties": false,
  "$id": "https://moai.local/contracts/kis072-period-request-v1.schema.json",
  "$comment": "Shape only; runtime defensive ingress and independent reconstruction required. Requested native W/M/Y never establishes actual coverage, period boundaries, finality, complete periods, units, identity or total return. Not canonical daily history."
}
