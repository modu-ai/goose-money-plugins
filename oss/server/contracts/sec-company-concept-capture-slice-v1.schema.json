{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "moai.sec.company-concept-capture-slice.v1"
    },
    "provider": {
      "type": "string",
      "const": "SEC"
    },
    "request": {
      "type": "object",
      "properties": {
        "cik": {
          "type": "string"
        },
        "taxonomy": {
          "type": "string",
          "enum": [
            "us-gaap",
            "ifrs-full"
          ]
        },
        "concept": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "cik",
        "taxonomy",
        "concept"
      ],
      "additionalProperties": false
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source_indices"
            },
            "indices": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 250000
              }
            }
          },
          "required": [
            "kind",
            "indices"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider_order_window"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250000
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "kind",
            "offset",
            "count"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capture": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "actual",
            "synthetic"
          ]
        },
        "received_at": {
          "type": "string",
          "maxLength": 80,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "source_url": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body_byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000000
        },
        "hash_scope": {
          "type": "string",
          "const": "decoded_response_text_utf8"
        },
        "hash_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "provenance_status": {
          "type": "string",
          "const": "caller_supplied_capture_metadata"
        },
        "source_authentication": {
          "type": "string",
          "const": "not_established"
        }
      },
      "required": [
        "origin",
        "received_at",
        "source_url",
        "body_sha256",
        "body_byte_length",
        "hash_scope",
        "hash_algorithm",
        "provenance_status",
        "source_authentication"
      ],
      "additionalProperties": false
    },
    "cutoff": {
      "type": "string",
      "maxLength": 80,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "calendar_guard": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cutoff_local_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "timezone",
        "cutoff_local_date"
      ],
      "additionalProperties": false
    },
    "identity_status": {
      "type": "string",
      "const": "source_cik_matched_not_security_identity"
    },
    "source_as_of": {
      "type": "null"
    },
    "rights": {
      "type": "string",
      "const": "pending"
    },
    "entity_name": {
      "type": "string",
      "maxLength": 1000
    },
    "taxonomy": {
      "type": "string",
      "enum": [
        "us-gaap",
        "ifrs-full"
      ]
    },
    "concept": {
      "type": "string",
      "maxLength": 200
    },
    "label": {
      "type": "string",
      "maxLength": 1000
    },
    "source_units": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_raw": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_/-]{0,79}$"
          },
          "source_unit_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "first_source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "fact_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "unit_raw",
          "source_unit_index",
          "first_source_index",
          "fact_count"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "source_unit_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "source_row_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "unit_raw": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_/-]{0,79}$"
          },
          "numeric_lexeme": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "accession_number": {
            "type": "string",
            "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
          },
          "filed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "fiscal_year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1900,
                "maximum": 9999
              },
              {
                "type": "null"
              }
            ]
          },
          "fiscal_period": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "form": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "frame": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ]
          },
          "period_kind": {
            "type": "string",
            "enum": [
              "duration",
              "instant"
            ]
          },
          "accounting_basis": {
            "type": "null"
          },
          "canonical_metric": {
            "type": "null"
          }
        },
        "required": [
          "source_index",
          "source_unit_index",
          "source_row_index",
          "unit_raw",
          "numeric_lexeme",
          "start",
          "end",
          "accession_number",
          "filed",
          "fiscal_year",
          "fiscal_period",
          "form",
          "frame",
          "period_kind",
          "accounting_basis",
          "canonical_metric"
        ],
        "additionalProperties": false
      }
    },
    "total_fact_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250000
    },
    "selected_fact_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "omitted_fact_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250000
    },
    "omitted_before_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250000
    },
    "omitted_between_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250000
    },
    "omitted_after_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250000
    },
    "selected_source_index_min": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 250000
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_source_index_max": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 250000
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_policy": {
      "type": "string",
      "const": "explicit_capture_bound_provider_order_no_semantic_selection"
    },
    "coverage_status": {
      "type": "string",
      "const": "supplied_capture_only_not_complete_filing_history"
    },
    "warnings": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "Decoded response text encoded as UTF-8 SHA256 binds the requested capture and indices, not compressed or TLS wire bytes; integrity is not source authentication or rights clearance."
        },
        {
          "type": "string",
          "const": "Capture origin, source URL and receipt are caller-supplied provenance, not independently verified transport observations."
        },
        {
          "type": "string",
          "const": "Absolute ordinals follow captured units member order then array row order, a capture convention not financial chronology. Numeric lexemes are retained; no latest, restatement or fiscal-period inference occurs."
        },
        {
          "type": "string",
          "const": "Date-only labels are not publication instants. Caller-selected calendar guards do not establish publication availability."
        },
        {
          "type": "string",
          "const": "No canonical metric, financial candidate, accounting basis, security identity or eligibility is produced. Source text is supplied separately."
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    }
  },
  "required": [
    "contract",
    "provider",
    "request",
    "selection",
    "capture",
    "cutoff",
    "calendar_guard",
    "identity_status",
    "source_as_of",
    "rights",
    "entity_name",
    "taxonomy",
    "concept",
    "label",
    "source_units",
    "facts",
    "total_fact_count",
    "selected_fact_count",
    "omitted_fact_count",
    "omitted_before_count",
    "omitted_between_count",
    "omitted_after_count",
    "selected_source_index_min",
    "selected_source_index_max",
    "selection_policy",
    "coverage_status",
    "warnings"
  ],
  "additionalProperties": false,
  "$comment": "STRUCTURE ONLY. JSON Schema omits runtime refinements, calendar/identity/cutoff checks, finite hostile-input limits, exact source-body hash, duplicate-key rejection, absolute source ordinal/count/omission reconstruction, and full persisted equality. Use sliceSecCompanyConceptCapture and verifySecCompanyConceptCaptureSlice with independent expectations and separately supplied original source text. No authentication or financial eligibility is established."
}
