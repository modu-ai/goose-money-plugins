{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^\\d{6}$"
    },
    "board": {
      "type": "string",
      "enum": [
        "J",
        "NX",
        "UN"
      ]
    },
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "interval": {
      "type": "string",
      "const": "1d"
    },
    "adjustment_code": {
      "type": "string",
      "enum": [
        "0",
        "1"
      ]
    }
  },
  "required": [
    "symbol",
    "board",
    "start_date",
    "end_date",
    "interval",
    "adjustment_code"
  ],
  "additionalProperties": false,
  "$id": "urn:moai:kis:kr-daily-raw-evidence:request:v1",
  "description": "Structural only. Runtime verification must reconstruct from independently supplied context and separately retained original body text. Calendar validity, receipt ordering, index/order/count and capture binding are runtime invariants."
}
