{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "board": {
          "type": "string",
          "enum": [
            "J",
            "NX",
            "UN"
          ]
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "interval": {
          "type": "string",
          "const": "1d"
        },
        "adjustment_code": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "required": [
        "symbol",
        "board",
        "start_date",
        "end_date",
        "interval",
        "adjustment_code"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "actual",
            "synthetic"
          ]
        },
        "received_at": {
          "type": "string",
          "maxLength": 80,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "expected_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "origin",
        "received_at",
        "expected_body_sha256"
      ],
      "additionalProperties": false
    },
    "cutoff": {
      "type": "string",
      "maxLength": 80,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "request",
    "capture",
    "cutoff"
  ],
  "additionalProperties": false,
  "$id": "urn:moai:kis:kr-daily-raw-evidence:input:v1",
  "description": "Structural only. Runtime verification must reconstruct from independently supplied context and separately retained original body text. Calendar validity, receipt ordering, index/order/count and capture binding are runtime invariants."
}
