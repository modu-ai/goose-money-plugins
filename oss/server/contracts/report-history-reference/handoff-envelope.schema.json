{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "moai.us-daily.canonical-history-handoff.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "synthetic_history_ready",
        "history_ready_under_external_trusted_verifier"
      ]
    },
    "actual_source_authenticated": {
      "type": "boolean",
      "const": false
    },
    "verified_live_provider_bindings": {
      "type": "number",
      "const": 0
    },
    "actual_provider_calls": {
      "type": "number",
      "const": 0
    },
    "cutoff": {
      "type": "string",
      "maxLength": 80,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "request": {},
    "history": {},
    "verification": {
      "type": "object",
      "properties": {
        "input_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "synthetic_test_only",
            "external_trusted_verification"
          ]
        },
        "verified_at": {
          "type": "string",
          "maxLength": 80,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "assurance": {
          "type": "string",
          "const": "trusted_adapter_attestation_not_independent_host_authentication"
        },
        "confirmed": {
          "type": "object",
          "properties": {
            "source_authenticity": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "identity": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "field_semantics": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "units": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "currency": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "scales": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "session_calendar": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "adjustment_actions": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "finality_revision": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "publication_availability": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "coverage": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "rights": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            }
          },
          "required": [
            "source_authenticity",
            "identity",
            "field_semantics",
            "units",
            "currency",
            "scales",
            "session_calendar",
            "adjustment_actions",
            "finality_revision",
            "publication_availability",
            "coverage",
            "rights"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "input_sha256",
        "adapter_id",
        "mode",
        "verified_at",
        "assurance",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "lineage": {},
    "rights": {},
    "inputs": {
      "type": "object",
      "properties": {
        "source": {},
        "binding": {}
      },
      "required": [
        "source",
        "binding"
      ],
      "additionalProperties": false
    },
    "report_runtime": {},
    "warnings": {}
  },
  "required": [
    "contract",
    "status",
    "actual_source_authenticated",
    "verified_live_provider_bindings",
    "actual_provider_calls",
    "cutoff",
    "request",
    "history",
    "verification",
    "lineage",
    "rights",
    "inputs",
    "report_runtime",
    "warnings"
  ],
  "additionalProperties": false,
  "description": "STRUCTURAL PROFILE ONLY. Runtime refinements, descriptor bounds, exact chronology, evidence linkage and fresh separately trusted verification are mandatory. Schema success never authenticates a source, authorizes rights or validates persisted success flags."
}
