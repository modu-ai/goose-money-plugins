{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "cik": {
          "type": "string"
        },
        "taxonomy": {
          "type": "string",
          "enum": [
            "us-gaap",
            "ifrs-full"
          ]
        },
        "concept": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "cik",
        "taxonomy",
        "concept"
      ],
      "additionalProperties": false
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source_indices"
            },
            "indices": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 250000
              }
            }
          },
          "required": [
            "kind",
            "indices"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider_order_window"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250000
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "kind",
            "offset",
            "count"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capture": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "actual",
            "synthetic"
          ]
        },
        "received_at": {
          "type": "string",
          "maxLength": 80,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "source_url": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "expected_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "origin",
        "received_at",
        "source_url",
        "expected_body_sha256"
      ],
      "additionalProperties": false
    },
    "cutoff": {
      "type": "string",
      "maxLength": 80,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "calendar_guard": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cutoff_local_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "timezone",
        "cutoff_local_date"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "request",
    "selection",
    "capture",
    "cutoff",
    "calendar_guard"
  ],
  "additionalProperties": false,
  "$comment": "STRUCTURE ONLY. JSON Schema omits runtime refinements, calendar/identity/cutoff checks, finite hostile-input limits, exact source-body hash, duplicate-key rejection, absolute source ordinal/count/omission reconstruction, and full persisted equality. Use sliceSecCompanyConceptCapture and verifySecCompanyConceptCaptureSlice with independent expectations and separately supplied original source text. No authentication or financial eligibility is established."
}
