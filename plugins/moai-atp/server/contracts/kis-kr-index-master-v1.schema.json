{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "nas",
            "nys",
            "ams",
            "kospi",
            "kosdaq",
            "kr_index_derivatives"
          ]
        },
        "format_status": {
          "type": "string",
          "const": "official_layout_checked_not_live_master_reconciled"
        },
        "source_authenticity": {
          "type": "string",
          "const": "unverified_injected_content"
        },
        "archive_ingestion": {
          "type": "string",
          "const": "not_implemented"
        },
        "encoding_status": {
          "type": "string",
          "enum": [
            "cp949_bytes_decoded",
            "caller_supplied_unicode"
          ]
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights_status": {
          "type": "string",
          "const": "pending"
        },
        "header_mode": {
          "type": "string",
          "enum": [
            "none",
            "documented_columns"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "warnings": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "required": [
        "profile",
        "format_status",
        "source_authenticity",
        "archive_ingestion",
        "encoding_status",
        "payload_sha256",
        "rights_status",
        "header_mode",
        "row_count",
        "warnings"
      ],
      "additionalProperties": false
    },
    "directory": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "actual",
            "synthetic"
          ]
        },
        "source_received_at": {
          "type": "string",
          "maxLength": 80,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "source_as_of": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80,
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "entries": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instrument_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "market": {
                "type": "string",
                "enum": [
                  "KR",
                  "US",
                  "unknown"
                ]
              },
              "asset_class": {
                "type": "string",
                "enum": [
                  "equity",
                  "etf",
                  "future",
                  "unknown"
                ]
              },
              "exchange": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "currency": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cik": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{10}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "corp_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{8}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "aliases": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "instrument_ref",
              "symbol",
              "name",
              "market",
              "asset_class",
              "exchange",
              "currency",
              "cik",
              "corp_code",
              "aliases",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "origin",
        "source_received_at",
        "source_as_of",
        "source_url",
        "entries",
        "coverage"
      ],
      "additionalProperties": false
    },
    "records": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "raw": {
            "type": "object",
            "properties": {
              "info_type": {
                "type": "string",
                "pattern": "^[A-Z0-9]$"
              },
              "shrn_iscd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
              },
              "stnd_iscd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
              },
              "kor_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "atm_cls_code": {
                "type": "string",
                "maxLength": 1
              },
              "acpr": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": ""
                  },
                  {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^-?\\d+(?:\\.\\d+)?$"
                  }
                ]
              },
              "mmsc_cls_code": {
                "type": "string",
                "maxLength": 1
              },
              "unas_shrn_iscd": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
                  },
                  {
                    "type": "string",
                    "const": ""
                  }
                ]
              },
              "unas_kor_name": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "info_type",
              "shrn_iscd",
              "stnd_iscd",
              "kor_name",
              "atm_cls_code",
              "acpr",
              "mmsc_cls_code",
              "unas_shrn_iscd",
              "unas_kor_name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source_line",
          "raw"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "metadata",
    "directory",
    "records"
  ],
  "additionalProperties": false
}
