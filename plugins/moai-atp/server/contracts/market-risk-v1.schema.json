{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "moai.stock.market-risk.v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "credit",
        "short_sale",
        "lending"
      ]
    },
    "request": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^\\d{6}$"
            },
            "settlement_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "symbol",
            "settlement_date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^\\d{6}$"
            },
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "symbol",
            "start_date",
            "end_date"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provider": {
      "type": "string",
      "const": "KIS"
    },
    "operation_ref": {
      "type": "string",
      "enum": [
        "KIS-110",
        "KIS-134",
        "KIS-135"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "actual",
        "synthetic"
      ]
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source_as_of": {
      "type": "null"
    },
    "rights": {
      "type": "string",
      "const": "pending"
    },
    "instrument_association": {
      "type": "string",
      "const": "request_filter_only"
    },
    "completeness": {
      "type": "string",
      "const": "one_page_not_verified_complete"
    },
    "has_more": {
      "type": "boolean"
    },
    "rows": {
      "maxItems": 101,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "response_root": {
            "type": "string",
            "enum": [
              "output",
              "output1",
              "output2"
            ]
          },
          "row_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "raw_fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "raw_value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "present_unverified",
                    "blank",
                    "missing",
                    "provider_null",
                    "raw_type_unverified"
                  ]
                }
              },
              "required": [
                "raw_value",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "date_basis": {
            "type": "object",
            "properties": {
              "trade_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "settlement_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "business_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "trade_date",
              "settlement_date",
              "business_date"
            ],
            "additionalProperties": false
          },
          "unit_verified_quantities": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^\\d+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "type": "string",
                  "const": "shares"
                },
                "scale": {
                  "type": "string",
                  "const": "1"
                },
                "source_field": {
                  "type": "string"
                },
                "source_lexeme": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "unit_verified",
                    "missing",
                    "blank",
                    "provider_null",
                    "raw_type_unverified",
                    "invalid_provider_domain"
                  ]
                },
                "evidence_url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "value",
                "unit",
                "scale",
                "source_field",
                "source_lexeme",
                "state",
                "evidence_url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "response_root",
          "row_index",
          "raw_fields",
          "date_basis",
          "unit_verified_quantities"
        ],
        "additionalProperties": false
      }
    },
    "canonical_projection_status": {
      "type": "string",
      "enum": [
        "partial_units_only",
        "blocked"
      ]
    },
    "canonical_blockers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "contract",
    "kind",
    "request",
    "provider",
    "operation_ref",
    "origin",
    "received_at",
    "source_as_of",
    "rights",
    "instrument_association",
    "completeness",
    "has_more",
    "rows",
    "canonical_projection_status",
    "canonical_blockers"
  ],
  "additionalProperties": false
}
