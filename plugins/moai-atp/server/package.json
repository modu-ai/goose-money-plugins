{
  "name": "@moai-atp/server",
  "version": "0.1.0-dev.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.2.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/test-desktop.mjs",
    "test:stdio": "npm run build && node --test dist/test/stdio.integration.test.js",
    "start": "node dist/src/main.js",
    "build:mjs": "node scripts/build-mjs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "license": "LGPL-3.0-only",
  "bin": {
    "moai-atp": "dist/src/cli.js"
  },
  "description": "모두의 주식 · MoAI ATP 로컬 연구 MCP·설정 CLI 개발 소스. 도구는 서버 기본값(읽기 스위치 꺼짐)에서 차단되고 출하 설정은 읽기 스위치를 켜며, 자동 실주문·수익 보장을 제공하지 않습니다."
}
